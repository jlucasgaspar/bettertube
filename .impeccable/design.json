      "html": "<div style=\"display:flex;gap:16px;padding:16px\"><button class=\"ds-switch\" role=\"switch\" aria-checked=\"false\"></button><button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\"></button></div>",
