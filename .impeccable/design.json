  "narrative": {
    "northStar": "The Projection Leader",
    "overview": "The panel is a reel leader: a strip of cue marks you read before the film starts. A clean white leader in light, a true-black projection room in dark, one red-orange accent (between YouTube red and Claude terracotta) that means exactly three things (on, focus, selection). Nothing else is colored, so a lit dot is always information. Hierarchy comes from scale contrast in one sturdy grotesque (Barlow), not from decoration, cards or shadow.",
    "keyCharacteristics": [
      "One accent (cue red), used only for on, focus, and text selection.",
      "Flat, tonal, bordered: no shadows, no cards, hairline rules between rows.",
      "Strict five-step type scale, Barlow 400/500/700, tabular numerals globally.",
      "Cue dot plus switch always paired; state is never shown by one alone.",
      "Two themes sharing one token set: light (white leader) and dark (true black), plus system."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "The accent appears only for on, focus, and selection. If something is red-orange it is lit; never use it for decoration, links or hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Focus Follows Theme Rule",
        "body": "Focus ring is 2px with 2px offset: Cue Red (#d93a22) in light, the brighter Focus Ember (#ff6a4d) in dark, so the ring holds contrast on both grounds.",
        "section": "colors"
      },
      {
        "name": "The Paired State Rule",
        "body": "A cue dot never appears alone on a toggle row; it always sits beside its switch.",
        "section": "colors"
      },
      {
        "name": "The Five Steps Rule",
        "body": "Only 12, 14, 16, 22 and 40px exist. A new size is a new step in the scale, not a one-off.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Tabular numerals are on at the root; do not turn them off.",
        "section": "typography"
      },
      {
        "name": "The No Shadow Rule",
        "body": "State is carried by fill, border and weight, never by elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair every toggle's switch with a cue dot, and let both read the same value.",
      "Do keep the accent for on, focus, and selection only.",
      "Do build hierarchy from the 12/14/16/22/40 scale and weight 400/500/700.",
      "Do separate rows with 1px hairlines and indent sub-settings 28px under their master.",
      "Do use standard controls (switch button, native select, outlined button) in the leader's palette.",
      "Do use the same token set for light and dark; switch themes by redefining the CSS custom properties only."
    ],
    "donts": [
      "Don't use blue toggles, gray-on-gray sidebars or any second accent color.",
      "Don't add shadows, cards or gradients to separate content.",
      "Don't introduce a font size or weight outside the scale.",
      "Don't use the accent for decoration, links or the current rail item.",
      "Don't number the rail sections or add kickers and eyebrows above titles."
    ]
  }
}
